# Copy to .env and fill in. What each setting does, and its default, is at the top of
# expense_agent/config.py. A line left out, or commented out, takes its default.
# PROVIDER=google
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# MODEL=  (default by PROVIDER: gemini-3.5-flash-lite or claude-haiku-5-5)
# EXPENSES_FILE=data/expenses.json
# MONGODB_URI=  (set: the expenses live in MongoDB Atlas, and EXPENSES_FILE is not used)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_TRACING_ENVIRONMENT=default
# TRACE_CONTENT=false
